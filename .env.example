# ==============================================================================
# HARDENED ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: Never commit the actual .env file to the repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE
# ------------------------------------------------------------------------------
NODE_ENV="development"              # development | staging | production
APP_NAME="[PROJECT_NAME]"
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
PORT_API=3001
PORT_WEB=3000

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/[PROJECT_NAME]_dev?schema=public"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false                  # true for staging/production

# ------------------------------------------------------------------------------
# 3. CACHE & QUEUE (Redis)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
# Upstash/TLS production format: rediss://default:[password]@[host]:6380

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & IAM (JWT & COOKIES)
# ------------------------------------------------------------------------------
# Generate via: openssl rand -base64 48
JWT_ACCESS_SECRET="[REPLACE_WITH_RANDOM_BASE64_STRING]"
JWT_REFRESH_SECRET="[REPLACE_WITH_RANDOM_BASE64_STRING]"
JWT_ACCESS_EXPIRY="15m"             # Must be short-lived (15 minutes)
JWT_REFRESH_EXPIRY="30d"            # Rotated refresh token (30 days)

# Cookie Configuration
COOKIE_DOMAIN="localhost"           # Frontend domain for production
COOKIE_SECURE=false                 # true for HTTPS in staging/production
COOKIE_SAME_SITE="Strict"           # Strict | Lax

# OAuth 2.0 / OIDC (Google)
GOOGLE_CLIENT_ID="[FROM_GOOGLE_CLOUD_CONSOLE]"
GOOGLE_CLIENT_SECRET="[FROM_GOOGLE_CLOUD_CONSOLE]"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# ------------------------------------------------------------------------------
# 5. CRYPTOGRAPHY & FIELD-LEVEL ENCRYPTION (FLE)
# ------------------------------------------------------------------------------
# Generate 32-byte hex string: openssl rand -hex 32
# Used for AES-256-GCM encryption on third-party tokens in the database
ENCRYPTION_MASTER_KEY="[REPLACE_WITH_64_CHAR_HEX_KEY]"

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & SECURITY HEADERS
# ------------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_TTL_MS=60000      # 1 minute
RATE_LIMIT_GLOBAL_MAX=100           # 100 requests per minute per IP
RATE_LIMIT_AUTH_MAX=5               # 5 requests per minute for /auth/login
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY & SECURITY AUDIT
# ------------------------------------------------------------------------------
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
LOG_LEVEL="debug"                   # debug | info | warn | error
ENABLE_AUDIT_LOGS=true

# ------------------------------------------------------------------------------
# 8. LLM / AGENT EVALS (optional — only for evals/ promptfoo harness)
# ------------------------------------------------------------------------------
# Fill in ONLY the provider you use. The evals guard script
# (scripts/run-evals.ps1 / run-evals.sh) can also set this interactively.
# Keys stay in this local .env — never commit them (gitleaks will block).
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GOOGLE_API_KEY="..."
