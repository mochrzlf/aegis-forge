# ==============================================================================
# HARDENED ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# PERINGATAN: Jangan pernah meng-commit file .env asli ke repositori!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE
# ------------------------------------------------------------------------------
NODE_ENV="development"              # development | staging | production
APP_NAME="[PROJECT_NAME]"
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
PORT_API=3001
PORT_WEB=3000

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/[PROJECT_NAME]_dev?schema=public"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false                  # true untuk staging/production

# ------------------------------------------------------------------------------
# 3. CACHE & QUEUE (Redis)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
# Format Upstash/TLS production: rediss://default:[password]@[host]:6380

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & IAM (JWT & COOKIES)
# ------------------------------------------------------------------------------
# Generate via: openssl rand -base64 48
JWT_ACCESS_SECRET="[REPLACE_WITH_RANDOM_BASE64_STRING]"
JWT_REFRESH_SECRET="[REPLACE_WITH_RANDOM_BASE64_STRING]"
JWT_ACCESS_EXPIRY="15m"             # Wajib short-lived (15 menit)
JWT_REFRESH_EXPIRY="30d"            # Rotated refresh token (30 hari)

# Cookie Configuration
COOKIE_DOMAIN="localhost"           # Domain frontend untuk production
COOKIE_SECURE=false                 # true untuk HTTPS di staging/production
COOKIE_SAME_SITE="Strict"           # Strict | Lax

# OAuth 2.0 / OIDC (Google)
GOOGLE_CLIENT_ID="[FROM_GOOGLE_CLOUD_CONSOLE]"
GOOGLE_CLIENT_SECRET="[FROM_GOOGLE_CLOUD_CONSOLE]"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# ------------------------------------------------------------------------------
# 5. CRYPTOGRAPHY & FIELD-LEVEL ENCRYPTION (FLE)
# ------------------------------------------------------------------------------
# Generate 32-byte hex string: openssl rand -hex 32
# Digunakan untuk enkripsi AES-256-GCM pada token pihak ketiga di database
ENCRYPTION_MASTER_KEY="[REPLACE_WITH_64_CHAR_HEX_KEY]"

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & SECURITY HEADERS
# ------------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_TTL_MS=60000      # 1 menit
RATE_LIMIT_GLOBAL_MAX=100           # 100 request per menit per IP
RATE_LIMIT_AUTH_MAX=5               # 5 request per menit untuk endpoint /auth/login
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY & SECURITY AUDIT
# ------------------------------------------------------------------------------
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
LOG_LEVEL="debug"                   # debug | info | warn | error
ENABLE_AUDIT_LOGS=true
