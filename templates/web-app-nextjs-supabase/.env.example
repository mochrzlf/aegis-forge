# Local Supabase (from `npx supabase start`) or your Supabase cloud project.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# Public anon key — safe to expose to the browser (RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY="CHANGE_ME_anon_key"

# NEVER put the service-role key here. It bypasses RLS and must never reach
# the browser or any NEXT_PUBLIC_* variable.
