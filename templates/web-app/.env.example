# --- App ---
APP_NAME="aegis-web-app"
APP_ENV="development"            # development | staging | production
API_PREFIX="/api/v1"

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="CHANGE_ME_48_urlsafe_bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Cookie flags (Secure should be true behind HTTPS in production)
COOKIE_SECURE=false
COOKIE_SAMESITE="strict"
COOKIE_PATH="/api/v1/auth"

# --- Database ---
POSTGRES_USER="aegis"
POSTGRES_PASSWORD="CHANGE_ME_strong_password"
POSTGRES_DB="aegis_app"
POSTGRES_HOST="db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://aegis:CHANGE_ME_strong_password@db:5432/aegis_app"

# --- Redis ---
REDIS_HOST="cache"
REDIS_PORT=6379
REDIS_URL="redis://cache:6379/0"

# --- Rate limiting (/auth/*) ---
# Window is shared by all limits below (seconds). Values are per identifier
# within one window — see ADR-003 before raising them.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_USER=10        # per account  — stalls password guessing
RATE_LIMIT_LOGIN_IP=30          # per IP       — stalls guessing across accounts
RATE_LIMIT_REGISTER_IP=5        # per IP       — open endpoint, no account needed
RATE_LIMIT_REFRESH_IP=60        # per IP       — token refresh storm control

# --- Observability ---
LOG_LEVEL="info"                 # debug | info | warn | error
