# --- App ---
APP_NAME="aegis-web-app"
APP_ENV="development"            # development | staging | production
API_PREFIX="/api/v1"

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="CHANGE_ME_48_urlsafe_bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Cookie flags (Secure should be true behind HTTPS in production)
COOKIE_SECURE=false
COOKIE_SAMESITE="strict"
COOKIE_PATH="/api/v1/auth"

# --- Database ---
POSTGRES_USER="aegis"
POSTGRES_PASSWORD="CHANGE_ME_strong_password"
POSTGRES_DB="aegis_app"
POSTGRES_HOST="db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://aegis:CHANGE_ME_strong_password@db:5432/aegis_app"

# --- Redis ---
REDIS_HOST="cache"
REDIS_PORT=6379
REDIS_URL="redis://cache:6379/0"

# --- Rate limiting (/auth/*) ---
# Window is shared by all limits below (seconds). Values are per identifier
# within one window — see ADR-003 before raising them.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_USER=10        # per account  — stalls password guessing
RATE_LIMIT_LOGIN_IP=30          # per IP       — stalls guessing across accounts
RATE_LIMIT_REGISTER_IP=5        # per IP       — open endpoint, no account needed
RATE_LIMIT_REFRESH_IP=60        # per IP       — token refresh storm control

RATE_LIMIT_PASSWORD_RESET_REQUEST_IP=5  # per IP  — unauthenticated, so tight
RATE_LIMIT_PASSWORD_RESET_EMAIL=3        # per email — bounds link spam to one mailbox
RATE_LIMIT_PASSWORD_RESET_CONFIRM_IP=10  # per IP  — token-guessing control
RATE_LIMIT_EMAIL_VERIFICATION_REQUEST_IP=5
RATE_LIMIT_EMAIL_VERIFICATION_CONFIRM_IP=10

# --- Account lockout (/auth/login) ---
# Both knobs share one horizon: failures age out after the same span a lock lasts.
LOCKOUT_MAX_FAILURES=5          # failed logins before the account locks
LOCKOUT_SECONDS=900             # lock duration = failure-tracking window (15 min)

# --- Password reset + email verification (ADR-007) ---
# Opaque single-use tokens, stored SHA-256-hashed (same pattern as refresh
# tokens), shorter-lived because they travel by email.
PASSWORD_RESET_TOKEN_MINUTES=30
EMAIL_VERIFICATION_TOKEN_HOURS=24
APP_BASE_URL="http://localhost:8000"   # base URL for links in outbound email

# --- Outbound mail (local Mailpit relay, see docker-compose) ---
# Leave SMTP_HOST empty to disable delivery entirely — links are then never sent
# and never echoed into an API response either.
SMTP_HOST="mailpit"
SMTP_PORT=1025
SMTP_FROM="no-reply@aegis-web-app.local"

# --- MFA / TOTP step-up (ADR-008) ---
MFA_STEP_UP_TOKEN_MINUTES=5      # step-up challenge token lifetime
MFA_BACKUP_CODE_COUNT=10         # one-time codes issued at activation
TOTP_REPLAY_TTL_SECONDS=90       # blocks reusing a code within its validity window

# --- Observability ---
LOG_LEVEL="info"                 # debug | info | warn | error
