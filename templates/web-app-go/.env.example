# Aegis Forge — Go Backend Environment Variables
PORT=8000
ENVIRONMENT=development

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegis_forge_dev
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aegis_forge_dev?sslmode=disable

# Cache & Rate Limiting
REDIS_URL=redis://localhost:6379/0

# Cryptographic Keys (Generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=dev_access_secret_do_not_use_in_prod_replace_me_32chars!
JWT_REFRESH_SECRET=dev_refresh_secret_do_not_use_in_prod_replace_me_32chars!

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000

# Seeder Credentials (make seed)
SEED_ADMIN_EMAIL=superadmin@aegisforge.dev
SEED_ADMIN_PASSWORD=SuperAdmin@Aegis123!
SEED_CHECKER_EMAIL=checker@aegisforge.dev
SEED_CHECKER_PASSWORD=CheckerAdmin@Aegis123!
