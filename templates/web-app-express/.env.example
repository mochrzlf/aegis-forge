# Aegis Forge — Express.js Backend Environment Configuration

PORT=8000
NODE_ENV=development

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_postgres_password_in_production
POSTGRES_DB=aegis_db
DATABASE_URL=postgres://postgres:change_this_postgres_password_in_production@localhost:5432/aegis_db

# Redis Cache
REDIS_URL=redis://localhost:6379

# Cryptographic Keys (Must be minimum 32 characters)
JWT_ACCESS_SECRET=replace_with_a_secure_jwt_access_secret_minimum_32_characters_long
JWT_REFRESH_SECRET=replace_with_a_secure_jwt_refresh_secret_minimum_32_characters_long

# CORS
CORS_ORIGIN=*
